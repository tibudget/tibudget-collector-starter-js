{
  "name": "@tibudget/collector-starter-js",
  "version": "2.0.0",
  "private": true,
  "description": "JavaScript skeleton of the Tibu demo website collector.",
  "license": "CC0-1.0",
  "author": "Tibu",
  "type": "module",
  "main": "./main.js",
  "exports": "./main.js",
  "files": [
    "main.js",
    "manifest.json",
    "logo.png",
    "_locales/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check main.js && node --check scripts/build.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "test": "node --experimental-vm-modules --test test/*.test.js",
    "docs": "jsdoc -c jsdoc.json"
  },
  "devDependencies": {
    "jsdoc": "4.0.4",
    "tibu": "npm:@tibudget/collector-sdk@0.1.0"
  }
}
